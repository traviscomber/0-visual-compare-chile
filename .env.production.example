# Production environment variables are managed in Vercel.
# Never commit real secrets or service-role credentials.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://your-production-domain.vercel.app
OPENAI_API_KEY=your-openai-api-key
CRON_SECRET=replace-with-a-long-random-secret

# Multimodel routing defaults (all optional).
# Keep unset to use the built-in Luna -> Terra -> Sol routing.
# OPENAI_LUNA_MODEL=gpt-5.6-luna
# OPENAI_TERRA_MODEL=gpt-5.6-terra
# OPENAI_SOL_MODEL=gpt-5.6-sol
# AI_LUNA_CONFIDENCE_THRESHOLD=0.78
# AI_TERRA_CONFIDENCE_THRESHOLD=0.68

# R&D / eval overrides. Setting one forces a single model for that classifier
# so previews can compare models without changing production routing logic.
# OPENAI_CLASSIFIER_MODEL=gpt-5.6-luna
# OPENAI_NIZA_MODEL=gpt-5.6-luna
# OPENAI_VIENA_MODEL=gpt-5.6-luna
