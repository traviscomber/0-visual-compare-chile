# Production environment variables are managed in Vercel.
# Never commit real secrets or service-role credentials.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://your-production-domain.vercel.app
OPENAI_API_KEY=your-openai-api-key

# Optional R&D model overrides. Keep unset to preserve the production baseline.
# OPENAI_CLASSIFIER_MODEL=gpt-4o
# OPENAI_NIZA_MODEL=gpt-4o
# OPENAI_VIENA_MODEL=gpt-4o
